d',
              quantity: String(data.quantity),
              total: money(total),
              shipping_address: address,
              payment_method: data.payment === 'Cash' ? 'Cash to Justin' : data.payment,
              notes: data.notes || 'None',
              _subject: subject,
              _replyto: data.email,
              _template: 'table',
              message: body
            })
          });
          const result = await response.json().catch(() => ({}));
          const msg = String(result.message || result.error || '');
          if (response.ok && (result.success === true || result.success === 'true')) {
            notifyState = 'ok';
          } else if (/activat/i.test(msg)) {
            notifyState = 'pending_activation';
          } else {
            notifyState = 'error';
          }
        } catch (err) {
          notifyState = 'error';
        }

        submitBtn.disabled = false;
        submitBtn.innerHTML = previousLabel;
        showConfirmation(data, total, address, subject, body, notifyState);
      });

      document.getElementById('editOrder').addEventListener('click', () => {
        confirmation.classList.remove('show');
        orderView.style.display = '';
        document.getElementById('order').scrollIntoView({ behavior: 'smooth' });
      });
    })();
  </script>
</body>
</html>
